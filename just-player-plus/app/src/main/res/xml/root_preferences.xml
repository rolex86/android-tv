<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="@string/pref_general_header">

        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/file_access_entries"
            app:entryValues="@array/file_access_values"
            app:key="fileAccess"
            app:title="@string/pref_file_access"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="autoPiP"
            app:defaultValue="false"
            app:summaryOn="@string/pref_auto_pip_on"
            app:summaryOff="@string/pref_auto_pip_off"
            app:title="@string/pref_auto_pip" />

        <SwitchPreferenceCompat
            app:key="skipSilence"
            app:defaultValue="false"
            app:summaryOn="@string/pref_skip_silence_on"
            app:summaryOff="@string/pref_skip_silence_off"
            app:title="@string/pref_skip_silence" />

        <SwitchPreferenceCompat
            app:key="repeatToggle"
            app:defaultValue="false"
            app:summary="@string/pref_repeat_toggle_summary"
            app:title="@string/pref_repeat_toggle" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_audio_header">

        <ListPreference
            app:key="languageAudio"
            app:defaultValue="device"
            app:title="@string/pref_language_audio"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="languageAudioSecondary"
            app:defaultValue="eng"
            app:title="@string/pref_language_audio_secondary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="languageAudioTertiary"
            app:defaultValue="none"
            app:title="@string/pref_language_audio_tertiary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="audioContentPreference"
            app:defaultValue="language"
            app:entries="@array/plus_audio_content_preference_entries"
            app:entryValues="@array/plus_audio_content_preference_values"
            app:title="@string/pref_audio_content_preference"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="audioQualityPreference"
            app:defaultValue="best"
            app:entries="@array/plus_audio_quality_entries"
            app:entryValues="@array/plus_audio_quality_values"
            app:title="@string/pref_audio_quality"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="ignoreCommentaryAudio"
            app:defaultValue="true"
            app:summary="@string/pref_ignore_commentary_audio_summary"
            app:title="@string/pref_ignore_commentary_audio" />

        <SwitchPreferenceCompat
            app:key="ignoreAudioDescription"
            app:defaultValue="true"
            app:summary="@string/pref_ignore_audio_description_summary"
            app:title="@string/pref_ignore_audio_description" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_subtitle_header">

        <ListPreference
            app:key="languageSubtitlePrimary"
            app:defaultValue="ces"
            app:title="@string/pref_language_subtitle"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="languageSubtitleSecondary"
            app:defaultValue="slk"
            app:title="@string/pref_language_subtitle_secondary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="languageSubtitleTertiary"
            app:defaultValue="eng"
            app:title="@string/pref_language_subtitle_tertiary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="subtitleMode"
            app:defaultValue="foreign_audio"
            app:entries="@array/plus_subtitle_mode_entries"
            app:entryValues="@array/plus_subtitle_mode_values"
            app:title="@string/pref_subtitle_mode"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="preferForcedSubtitles"
            app:defaultValue="true"
            app:summary="@string/pref_prefer_forced_subtitles_summary"
            app:title="@string/pref_prefer_forced_subtitles" />

        <SwitchPreferenceCompat
            app:key="allowUnknownSubtitles"
            app:defaultValue="true"
            app:summary="@string/pref_allow_unknown_subtitles_summary"
            app:title="@string/pref_allow_unknown_subtitles" />

        <SwitchPreferenceCompat
            app:key="ignoreSdhSubtitles"
            app:defaultValue="true"
            app:summary="@string/pref_ignore_sdh_subtitles_summary"
            app:title="@string/pref_ignore_sdh_subtitles" />

        <ListPreference
            app:key="subtitleSourcePreference"
            app:defaultValue="auto"
            app:entries="@array/plus_subtitle_source_entries"
            app:entryValues="@array/plus_subtitle_source_values"
            app:title="@string/pref_subtitle_source"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="subtitleDelayMs"
            app:defaultValue="0"
            app:dialogTitle="@string/pref_subtitle_delay"
            app:summary="@string/pref_subtitle_delay_summary"
            app:title="@string/pref_subtitle_delay"
            android:inputType="numberSigned" />

        <ListPreference
            app:key="subtitleScale"
            app:defaultValue="system"
            app:entries="@array/plus_subtitle_scale_entries"
            app:entryValues="@array/plus_subtitle_scale_values"
            app:title="@string/pref_subtitle_scale"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="subtitlePosition"
            app:defaultValue="system"
            app:entries="@array/plus_subtitle_position_entries"
            app:entryValues="@array/plus_subtitle_position_values"
            app:title="@string/pref_subtitle_position"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="openSubtitlesExactMatch"
            app:defaultValue="true"
            app:summaryOn="@string/pref_opensubtitles_exact_match_on"
            app:summaryOff="@string/pref_opensubtitles_exact_match_off"
            app:title="@string/pref_opensubtitles_exact_match" />

        <Preference
            app:key="openSubtitlesCredentials"
            app:dependency="openSubtitlesExactMatch"
            app:title="@string/pref_opensubtitles_credentials" />

        <Preference
            app:key="openSubtitlesTest"
            app:dependency="openSubtitlesExactMatch"
            app:summary="@string/pref_opensubtitles_test_summary"
            app:title="@string/pref_opensubtitles_test" />

        <SwitchPreferenceCompat
            app:key="subtitleStyleEmbedded"
            app:defaultValue="true"
            app:summaryOn="@string/pref_subtitle_style_embedded_on"
            app:summaryOff="@string/pref_subtitle_style_embedded_off"
            app:title="@string/pref_subtitle_style_embedded" />

        <SwitchPreferenceCompat
            app:key="subtitleStyleBold"
            app:defaultValue="false"
            app:summaryOn="@string/pref_subtitle_style_bold_on"
            app:summaryOff="@string/pref_subtitle_style_bold_off"
            app:title="@string/pref_subtitle_style_bold" />

        <Preference app:title="@string/pref_captioning_preferences">
            <intent android:action="android.settings.CAPTIONING_SETTINGS" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_memory_header">

        <ListPreference
            app:key="rememberTrackScope"
            app:defaultValue="series"
            app:entries="@array/plus_remember_scope_entries"
            app:entryValues="@array/plus_remember_scope_values"
            app:title="@string/pref_remember_track_scope"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_playback_header">

        <ListPreference
            app:key="resizeDefault"
            app:defaultValue="remember"
            app:entries="@array/plus_resize_default_entries"
            app:entryValues="@array/plus_resize_default_values"
            app:title="@string/pref_resize_default"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="speedDefault"
            app:defaultValue="remember"
            app:entries="@array/plus_speed_default_entries"
            app:entryValues="@array/plus_speed_default_values"
            app:title="@string/pref_speed_default"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="seekIncrementMs"
            app:defaultValue="10000"
            app:entries="@array/plus_seek_increment_entries"
            app:entryValues="@array/plus_seek_increment_values"
            app:title="@string/pref_seek_increment"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="networkBufferProfile"
            app:defaultValue="default"
            app:entries="@array/plus_network_buffer_entries"
            app:entryValues="@array/plus_network_buffer_values"
            app:title="@string/pref_network_buffer"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="showEndTime"
            app:defaultValue="true"
            app:summaryOn="@string/pref_show_end_time_on"
            app:summaryOff="@string/pref_show_end_time_off"
            app:title="@string/pref_show_end_time" />

        <SwitchPreferenceCompat
            app:key="frameRateMatching"
            app:defaultValue="false"
            app:summaryOn="@string/pref_framerate_matching_on"
            app:summaryOff="@string/pref_framerate_matching_off"
            app:title="@string/pref_framerate_matching" />

        <ListPreference
            app:key="frameRatePolicy"
            app:defaultValue="legacy"
            app:entries="@array/plus_frame_rate_policy_entries"
            app:entryValues="@array/plus_frame_rate_policy_values"
            app:title="@string/pref_frame_rate_policy"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_external_player_header">

        <SwitchPreferenceCompat
            app:key="stremioConnectorEnabled"
            app:defaultValue="false"
            app:summaryOn="@string/pref_stremio_connector_on"
            app:summaryOff="@string/pref_stremio_connector_off"
            app:title="@string/pref_stremio_connector" />

        <Preference
            app:key="stremioConnectorInstall"
            app:dependency="stremioConnectorEnabled"
            app:summary="@string/pref_stremio_connector_install_summary"
            app:title="@string/pref_stremio_connector_install" />

        <SwitchPreferenceCompat
            app:key="stremioAggregationEnabled"
            app:dependency="stremioConnectorEnabled"
            app:defaultValue="false"
            app:summaryOn="@string/pref_stremio_aggregation_on"
            app:summaryOff="@string/pref_stremio_aggregation_off"
            app:title="@string/pref_stremio_aggregation" />

        <ListPreference
            app:key="nextEpisodeNoticeSeconds"
            app:dependency="stremioConnectorEnabled"
            app:defaultValue="30"
            app:entries="@array/plus_next_episode_notice_entries"
            app:entryValues="@array/plus_next_episode_notice_values"
            app:title="@string/pref_next_episode_notice"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="nextEpisodePopupSize"
            app:dependency="stremioConnectorEnabled"
            app:defaultValue="medium"
            app:entries="@array/plus_next_episode_popup_size_entries"
            app:entryValues="@array/plus_next_episode_popup_size_values"
            app:title="@string/pref_next_episode_popup_size"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="backButtonBehavior"
            app:defaultValue="controls_then_exit"
            app:entries="@array/plus_back_button_entries"
            app:entryValues="@array/plus_back_button_values"
            app:title="@string/pref_back_button_behavior"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="completionRule"
            app:defaultValue="percent_95"
            app:entries="@array/plus_completion_entries"
            app:entryValues="@array/plus_completion_values"
            app:title="@string/pref_completion_rule"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="externalPlayerDiagnostics"
            app:defaultValue="false"
            app:summary="@string/pref_external_player_diagnostics_summary"
            app:title="@string/pref_external_player_diagnostics" />

        <Preference
            app:key="externalPlayerDiagnosticsView"
            app:dependency="externalPlayerDiagnostics"
            app:summary="@string/pref_external_player_diagnostics_view_summary"
            app:title="@string/pref_external_player_diagnostics_view" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="stremioAggregationCategory"
        app:title="@string/pref_stremio_aggregation_header">

        <Preference
            app:key="stremioAggregationSources"
            app:summary="@string/pref_stremio_sources_empty"
            app:title="@string/pref_stremio_sources" />

        <ListPreference
            app:key="stremioAggregationSortMode"
            app:defaultValue="quality_interleaved"
            app:entries="@array/plus_stremio_sort_entries"
            app:entryValues="@array/plus_stremio_sort_values"
            app:title="@string/pref_stremio_sort"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="stremioAggregationPreferCached"
            app:defaultValue="false"
            app:summary="@string/pref_stremio_prefer_cached_summary"
            app:title="@string/pref_stremio_prefer_cached" />

        <ListPreference
            app:key="stremioAggregationSizeSort"
            app:defaultValue="none"
            app:entries="@array/plus_stremio_size_sort_entries"
            app:entryValues="@array/plus_stremio_size_sort_values"
            app:title="@string/pref_stremio_size_sort"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="stremioAggregationPreferredLanguages"
            app:defaultValue=""
            app:dialogTitle="@string/pref_stremio_preferred_languages"
            app:summary="@string/pref_stremio_preferred_languages_summary"
            app:title="@string/pref_stremio_preferred_languages"
            android:inputType="text" />

        <MultiSelectListPreference
            app:key="stremioAggregationResolutions"
            app:defaultValue="@array/plus_stremio_resolution_values"
            app:entries="@array/plus_stremio_resolution_entries"
            app:entryValues="@array/plus_stremio_resolution_values"
            app:title="@string/pref_stremio_resolutions" />

        <MultiSelectListPreference
            app:key="stremioAggregationStreamTypes"
            app:defaultValue="@array/plus_stremio_stream_type_values"
            app:entries="@array/plus_stremio_stream_type_entries"
            app:entryValues="@array/plus_stremio_stream_type_values"
            app:title="@string/pref_stremio_stream_types" />

        <MultiSelectListPreference
            app:key="stremioAggregationBlockedReleases"
            app:entries="@array/plus_stremio_bad_release_entries"
            app:entryValues="@array/plus_stremio_bad_release_values"
            app:summary="@string/pref_stremio_blocked_releases_summary"
            app:title="@string/pref_stremio_blocked_releases" />

        <MultiSelectListPreference
            app:key="stremioAggregationCodecs"
            app:defaultValue="@array/plus_stremio_codec_values"
            app:entries="@array/plus_stremio_codec_entries"
            app:entryValues="@array/plus_stremio_codec_values"
            app:title="@string/pref_stremio_codecs" />

        <MultiSelectListPreference
            app:key="stremioAggregationHdrFormats"
            app:defaultValue="@array/plus_stremio_hdr_values"
            app:entries="@array/plus_stremio_hdr_entries"
            app:entryValues="@array/plus_stremio_hdr_values"
            app:title="@string/pref_stremio_hdr" />

        <SwitchPreferenceCompat
            app:key="stremioAggregationKeepUnknownTech"
            app:defaultValue="true"
            app:summary="@string/pref_stremio_keep_unknown_tech_summary"
            app:title="@string/pref_stremio_keep_unknown_tech" />

        <EditTextPreference
            app:key="stremioAggregationAllowedLanguages"
            app:defaultValue=""
            app:dialogTitle="@string/pref_stremio_allowed_languages"
            app:summary="@string/pref_stremio_allowed_languages_summary"
            app:title="@string/pref_stremio_allowed_languages"
            android:inputType="text" />

        <SwitchPreferenceCompat
            app:key="stremioAggregationKeepUnknownLanguage"
            app:defaultValue="true"
            app:summary="@string/pref_stremio_keep_unknown_language_summary"
            app:title="@string/pref_stremio_keep_unknown_language" />

        <EditTextPreference
            app:key="stremioAggregationMinSizeGb"
            app:defaultValue="0"
            app:dialogTitle="@string/pref_stremio_min_size"
            app:title="@string/pref_stremio_min_size"
            android:inputType="numberDecimal" />

        <EditTextPreference
            app:key="stremioAggregationMaxSizeGb"
            app:defaultValue="0"
            app:dialogTitle="@string/pref_stremio_max_size"
            app:title="@string/pref_stremio_max_size"
            android:inputType="numberDecimal" />

        <SwitchPreferenceCompat
            app:key="stremioAggregationKeepUnknownSize"
            app:defaultValue="true"
            app:summary="@string/pref_stremio_keep_unknown_size_summary"
            app:title="@string/pref_stremio_keep_unknown_size" />

        <EditTextPreference
            app:key="stremioAggregationBlockedText"
            app:defaultValue=""
            app:dialogTitle="@string/pref_stremio_blocked_text"
            app:summary="@string/pref_stremio_blocked_text_summary"
            app:title="@string/pref_stremio_blocked_text"
            android:inputType="textMultiLine" />

        <EditTextPreference
            app:key="stremioAggregationMaxTotal"
            app:defaultValue="100"
            app:dialogTitle="@string/pref_stremio_max_total"
            app:title="@string/pref_stremio_max_total"
            android:inputType="number" />

        <EditTextPreference
            app:key="stremioAggregationMaxPerSource"
            app:defaultValue="30"
            app:dialogTitle="@string/pref_stremio_max_source"
            app:title="@string/pref_stremio_max_source"
            android:inputType="number" />

        <EditTextPreference
            app:key="stremioAggregationMaxPerQuality"
            app:defaultValue="0"
            app:dialogTitle="@string/pref_stremio_max_quality"
            app:title="@string/pref_stremio_max_quality"
            android:inputType="number" />

        <ListPreference
            app:key="stremioAggregationDeduplication"
            app:defaultValue="safe"
            app:entries="@array/plus_stremio_deduplication_entries"
            app:entryValues="@array/plus_stremio_deduplication_values"
            app:title="@string/pref_stremio_deduplication"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="stremioAggregationBingeGroup"
            app:defaultValue="quality"
            app:entries="@array/plus_stremio_binge_entries"
            app:entryValues="@array/plus_stremio_binge_values"
            app:title="@string/pref_stremio_binge"
            app:useSimpleSummaryProvider="true" />

        <MultiSelectListPreference
            app:key="stremioAggregationDisplayFields"
            app:defaultValue="@array/plus_stremio_display_values"
            app:entries="@array/plus_stremio_display_entries"
            app:entryValues="@array/plus_stremio_display_values"
            app:summary="@string/pref_stremio_display_summary"
            app:title="@string/pref_stremio_display" />

        <Preference
            app:key="stremioAggregationReset"
            app:summary="@string/pref_stremio_reset_summary"
            app:title="@string/pref_stremio_reset" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_ai_subtitles_header">

        <SwitchPreferenceCompat
            app:key="aiSubtitlesEnabled"
            app:defaultValue="false"
            app:summaryOn="@string/pref_ai_subtitles_enabled_on"
            app:summaryOff="@string/pref_ai_subtitles_enabled_off"
            app:title="@string/pref_ai_subtitles_enabled" />

        <EditTextPreference
            app:key="aiSubtitleBackendUrl"
            app:defaultValue=""
            app:dependency="aiSubtitlesEnabled"
            app:dialogTitle="@string/pref_ai_subtitle_backend_url"
            app:title="@string/pref_ai_subtitle_backend_url"
            android:inputType="textUri" />

        <EditTextPreference
            app:key="aiSubtitleApiToken"
            app:defaultValue=""
            app:dependency="aiSubtitlesEnabled"
            app:dialogTitle="@string/pref_ai_subtitle_api_token"
            app:summary="@string/pref_ai_subtitle_api_token_summary"
            app:title="@string/pref_ai_subtitle_api_token"
            android:inputType="textPassword" />

        <ListPreference
            app:key="aiSubtitleTargetLanguage"
            app:defaultValue="ces"
            app:dependency="aiSubtitlesEnabled"
            app:entries="@array/plus_ai_subtitle_language_entries"
            app:entryValues="@array/plus_ai_subtitle_language_values"
            app:title="@string/pref_ai_subtitle_target_language"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:key="aiSubtitleHttpWarning"
            app:dependency="aiSubtitlesEnabled"
            app:selectable="false"
            app:summary="@string/pref_ai_subtitle_http_warning" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_dangerous_header">

        <Preference
            app:selectable="false"
            app:summary="@string/pref_dangerous_warning" />

        <ListPreference
            app:defaultValue="1"
            app:entries="@array/decoder_priority_entries"
            app:entryValues="@array/decoder_priority_values"
            app:key="decoderPriority"
            app:title="@string/pref_decoder_priority"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="tunneling"
            app:defaultValue="false"
            app:summary="@string/pref_tunneling_summary"
            app:title="@string/pref_tunneling" />

        <SwitchPreferenceCompat
            app:key="mapDV7ToHevc"
            app:defaultValue="false"
            app:summaryOn="@string/pref_map_dv7_on"
            app:summaryOff="@string/pref_map_dv7_off"
            app:title="@string/pref_map_dv7" />

    </PreferenceCategory>

</PreferenceScreen>
