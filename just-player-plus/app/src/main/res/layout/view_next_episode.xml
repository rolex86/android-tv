<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/next_episode_card"
    android:layout_width="380dp"
    android:layout_height="158dp"
    android:layout_gravity="end|bottom"
    android:layout_marginEnd="40dp"
    android:layout_marginBottom="40dp"
    android:background="@drawable/next_episode_card_background"
    android:elevation="16dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/next_episode_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.82"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/next_episode_scrim" />

    <LinearLayout
        android:id="@+id/next_episode_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/next_episode_series_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_episode_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFE1E4EB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/next_episode_actions"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/next_episode_play_now"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/next_episode_primary_button"
                android:drawableStart="@drawable/ic_play_arrow_24dp"
                android:drawablePadding="5dp"
                android:drawableTint="#FF171923"
                android:focusable="true"
                android:fontFamily="sans"
                android:minWidth="122dp"
                android:nextFocusDown="@id/next_episode_play_now"
                android:nextFocusLeft="@id/next_episode_play_now"
                android:nextFocusRight="@id/next_episode_dismiss"
                android:nextFocusUp="@id/next_episode_play_now"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/next_episode_play_now"
                android:textAllCaps="false"
                android:textColor="@color/next_episode_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/next_episode_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/next_episode_secondary_button"
                android:focusable="true"
                android:fontFamily="sans"
                android:minWidth="92dp"
                android:nextFocusDown="@id/next_episode_dismiss"
                android:nextFocusLeft="@id/next_episode_play_now"
                android:nextFocusRight="@id/next_episode_dismiss"
                android:nextFocusUp="@id/next_episode_dismiss"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/next_episode_dismiss"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
